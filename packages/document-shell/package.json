{
  "name": "@dt/document-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./src/runtime.ts"
    },
    "./styles/island.css": "./src/styles/island.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "build": "mkdir -p dist && echo 'document-shell is bundled by apps/web' > dist/.gitkeep",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@dt/document-schema": "workspace:*",
    "@dt/i18n": "workspace:*",
    "@dt/ui-kit": "workspace:*",
    "element-plus": "^2.14.8",
    "vxe-pc-ui": "^4.10.0",
    "vxe-table": "^4.23.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "pinia": "^2.2.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  },
  "peerDependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  }
}
